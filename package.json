{
  "name": "privacy-guard-userscript",
  "version": "1.11.0",
  "description": "UserScript to enhance privacy protection across websites.",
  "type": "module",
  "scripts": {
    "prebuild": "node -e \"const fs=require('node:fs'); for (const dir of ['dist', 'coverage', '.cache']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "build": "rollup -c && prettier --write dist/*.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preinstall": "node scripts/guard-engines.js",
    "lint": "concurrently -n ESLINT,STYLELINT --raw --success=all \"npm:lint:eslint\" \"npm:lint:stylelint\"",
    "lint:eslint": "eslint . --cache --cache-strategy content --cache-location .cache/eslint/",
    "lint:fix": "eslint --fix . --cache --cache-strategy content --cache-location .cache/eslint/ && stylelint --allow-empty-input --fix \"**/*.{css,scss}\" --cache --cache-strategy content --cache-location .cache/stylelint/",
    "lint:stylelint": "stylelint --allow-empty-input \"**/*.{css,scss}\" --cache --cache-strategy content --cache-location .cache/stylelint/",
    "prepare": "husky",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --reporters=default",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:related": "node --experimental-vm-modules node_modules/jest/bin/jest.js --findRelatedTests",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run format:check"
  },
  "overrides": {
    "glob": "^9",
    "inflight": false,
    "npm": "^11",
    "semver-diff": false
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.2",
    "@homer0/prettier-plugin-jsdoc": "^11.1.0",
    "@html-eslint/eslint-plugin": "^0.63.0",
    "@html-eslint/parser": "^0.63.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.4",
    "@types/tampermonkey": "^5.0.5",
    "concurrently": "^9.2.3",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.15.3",
    "eslint-plugin-jest-dom": "github:Aesthermortis/eslint-plugin-jest-dom",
    "eslint-plugin-jest-extended": "github:Aesthermortis/eslint-plugin-jest-extended",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-n": "^18.2.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-promise": "github:Aesthermortis/eslint-plugin-promise",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-yml": "^3.5.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-extended": "^7.0.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "rollup": "^4.62.2",
    "stylelint": "^17.14.0",
    "stylelint-config-clean-order": "^8.0.2",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "yaml-eslint-parser": "^2.0.0"
  },
  "packageManager": "npm@11.0.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
